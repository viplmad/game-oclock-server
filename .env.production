## Configuration

## Authentication
# (Required) Secret key used for encoding/decoding authentication tokens
SECRET_KEY=someRandomString

## Server
# (Optional, Defaults to 0.0.0.0) Host
#HOST=0.0.0.0
# (Optional, Defaults to 80) Port where the application is served
#PORT=80

## Database connection configuration
# (Required) Host of the database
DB_HOST=db
# (Required) Port of the database
DB_PORT=5432
# (Required) Database name
DB_DATABASE=game-oclock
# (Required) Username of the user accessing the database
DB_USER=game-oclock
# (Required) User password of the user accessing the database
DB_PASSWORD=game-oclock

## (Optional, Defaults to '' i.e. no logs) Logging parameters for debugging
RUST_LOG=game_oclock_server#,sqlx
